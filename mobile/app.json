{
  "expo": {
    "name": "Recycler",
    "slug": "recycler",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "recycler",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png",
        "tinted": "./assets/images/icon-tinted.png"
      },
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Recycler uses your photo library so you can attach a picture to a reuse idea.",
        "NSCameraUsageDescription": "Recycler uses the camera so you can photograph a reuse idea."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7F3EA",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.RECORD_AUDIO"],
      "package": "com.recycler.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F7F3EA"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Recycler uses your photo library so you can attach a picture to a reuse idea.",
          "cameraPermission": "Recycler uses the camera so you can photograph a reuse idea."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "97fae3d5-e974-438a-8850-79b78d1d57e6"
      }
    }
  }
}

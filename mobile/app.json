{
  "expo": {
    "name": "Recycler",
    "slug": "recycler",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "recycler",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Recycler uses your photo library so you can attach a picture to a reuse idea.",
        "NSCameraUsageDescription": "Recycler uses the camera so you can photograph a reuse idea."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#f4efe6",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#f4efe6"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Recycler uses your photo library so you can attach a picture to a reuse idea.",
          "cameraPermission": "Recycler uses the camera so you can photograph a reuse idea."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
